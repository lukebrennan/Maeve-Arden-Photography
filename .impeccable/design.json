    {
      "name": "Text field",
      "kind": "input",
      "refersTo": "input",
      "description": "Visible labels, square transparent fields, shared focus and explicit invalid and disabled states.",
      "html": "<div class=\"ds-field\"><label for=\"ds-venue\">Venue or location <span>(optional)</span></label><input id=\"ds-venue\" type=\"text\" placeholder=\"A venue, a town, a country…\"></div>",
      "css": ".ds-field{font-family:Geologica,sans-serif;color:var(--ink,#302f2c)}.ds-field>label{display:block;font-size:13px;font-weight:300;line-height:1.65;margin-bottom:10px}.ds-field label>span{color:var(--muted,#67625b);font-size:11px}.ds-field>input{display:block;box-sizing:border-box;width:100%;min-height:48px;border:1px solid var(--control-line,#8a8379);border-radius:0;padding:11px;background:transparent;color:var(--ink,#302f2c);font-family:Geologica,sans-serif;font-size:14px;font-weight:300;line-height:1.65;caret-color:var(--charcoal,#343330)}.ds-field>input::placeholder{color:var(--muted,#67625b);opacity:1}.ds-field>input:hover{cursor:text}.ds-field>input:focus-visible{outline:2px solid currentColor;outline-offset:5px;}.ds-field>input[aria-invalid=\"true\"]{border:2px solid var(--error,#9d2926)}.ds-field>input:disabled{opacity:.55;background:var(--ground,#f7f5ef)}@media(max-width:600px){.ds-field>input{font-size:16px}}"
    },
    {
      "name": "Desktop navigation",
      "kind": "nav",
      "refersTo": "navigation-link",
      "description": "Quiet normal-case links; underline marks the current page and hover. The full site changes to a dialog at 900px.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Sample navigation\"><a href=\"#work-preview\" aria-current=\"page\">Selected work</a><a href=\"#experience-preview\">The experience</a><a href=\"#about-preview\">About</a></nav>",
      "css": ".ds-nav{display:flex;gap:30px;align-items:center;background:var(--ground,#f7f5ef);color:var(--ink,#302f2c);font-family:Geologica,sans-serif;font-weight:300;line-height:1.65}.ds-nav>a{min-height:44px;display:flex;align-items:center;text-decoration:none;font-size:13px;color:inherit;text-decoration-thickness:1px;text-underline-offset:5px}.ds-nav>a:hover,.ds-nav>a[aria-current]{text-decoration:underline}.ds-nav>a:focus-visible{outline:2px solid currentColor;outline-offset:5px;}"
    },
    {
      "name": "Gallery filters",
      "kind": "custom",
      "description": "Flat filter controls with a pressed-state underline; these are not filled chips.",
      "html": "<div class=\"ds-filters\" aria-label=\"Sample photograph categories\"><button type=\"button\" aria-pressed=\"true\">All photographs</button><button type=\"button\" aria-pressed=\"false\">People</button><button type=\"button\" aria-pressed=\"false\">Places</button></div>",
      "css": ".ds-filters{display:flex;flex-wrap:wrap;gap:28px;border-bottom:1px solid var(--line,#c9c1b5);font-family:Geologica,sans-serif;color:var(--ink,#302f2c)}.ds-filters button{min-height:50px;background:transparent;padding:7px 0;font-family:Geologica,sans-serif;font-weight:300;line-height:1.65;font-size:14px;color:inherit;cursor:pointer;border:0;border-bottom:2px solid transparent}.ds-filters button:hover{background:transparent}.ds-filters button[aria-pressed=\"true\"]{font-weight:500;border-color:var(--charcoal,#343330);color:var(--charcoal,#343330)}.ds-filters button:focus-visible{outline:2px solid currentColor;outline-offset:5px;}@media(max-width:600px){.ds-filters{gap:20px}.ds-filters button{font-size:12px;min-height:44px}}"
    },
    {
      "name": "Place index",
      "kind": "custom",
      "description": "The user-controlled folio index combines a label, thin rule and filled selected-state circle.",
      "html": "<div class=\"ds-place-index\" aria-label=\"Sample folio places\"><button type=\"button\" aria-pressed=\"true\">Lake District</button><button type=\"button\" aria-pressed=\"false\">London</button><button type=\"button\" aria-pressed=\"false\">Celebrations</button></div>",
      "css": ".ds-place-index{display:flex;flex-direction:column;gap:1px;max-width:250px;color:var(--ink,#302f2c);font-family:Geologica,sans-serif}.ds-place-index button{font-family:Geologica,sans-serif;font-size:14px;line-height:1.65;text-align:left;background:none;min-height:48px;padding:9px 0;border:0;border-bottom:1px solid var(--line,#c9c1b5);font-weight:300;color:inherit;position:relative;cursor:pointer}.ds-place-index button:hover{background:none}.ds-place-index button[aria-pressed=\"true\"]{font-weight:500;color:var(--charcoal,#343330)}.ds-place-index button::after{content:\"\";position:absolute;right:2px;top:19px;width:7px;height:7px;border:1px solid var(--charcoal,#343330);border-radius:50%}.ds-place-index button[aria-pressed=\"true\"]::after{background:var(--charcoal,#343330)}.ds-place-index button:focus-visible{outline:2px solid currentColor;outline-offset:5px;}"
    },
    {
      "name": "Collection option",
      "kind": "custom",
      "refersTo": "collection-option",
      "description": "A native radio within a square row; selection adds blue stroke and lake-blue fill.",
      "html": "<label class=\"ds-option\"><input type=\"radio\" name=\"ds-collection\" checked><span><strong>The Story</strong><small>From £2,850</small></span></label>",
      "css": ".ds-option{display:flex;gap:11px;align-items:center;min-height:78px;box-sizing:border-box;border:1px solid var(--control-line,#8a8379);padding:12px;cursor:pointer;color:var(--ink,#302f2c);font-family:Geologica,sans-serif;line-height:1.65}.ds-option:hover{cursor:pointer}.ds-option:has(:checked){border-color:var(--charcoal,#343330);background:var(--ground,#f7f5ef)}.ds-option input{accent-color:var(--charcoal,#343330);width:18px;height:18px;flex-shrink:0}.ds-option input:focus-visible{outline:2px solid currentColor;outline-offset:5px;}.ds-option strong{font-weight:450;font-size:14px;display:block}.ds-option small{display:block;font-size:12px;font-weight:300;margin-top:3px}"
    },
    {
      "name": "Pricing band",
      "kind": "card",
      "refersTo": "pricing-band",
      "description": "A flat collection row with separated description, price and coverage; mobile stacks the supporting content.",
      "html": "<article class=\"ds-price-band\"><h3>The Intimate</h3><p>For a smaller celebration, with space for what matters.</p><div class=\"ds-price\"><span>From</span>£1,450</div><ul><li>Thoughtful coverage</li><li>A considered collection of photographs</li></ul><a class=\"ds-price-action\" href=\"#enquiry-preview\">Check your date</a></article>",
      "css": ".ds-price-band{display:grid;grid-template-columns:1fr .6fr 1.2fr;gap:18px 50px;padding:42px 30px;border-top:1px solid var(--line,#c9c1b5);border-bottom:1px solid var(--line,#c9c1b5);align-items:start;color:var(--ink,#302f2c);font-family:Geologica,sans-serif;font-weight:300;line-height:1.65}.ds-price-band h3{margin:0;font-size:25px;grid-column:1;grid-row:1;font-weight:400;line-height:1.2;letter-spacing:-.035em}.ds-price-band>p{margin:0;grid-column:1;grid-row:2;font-size:14px;max-width:28ch}.ds-price{grid-column:2;grid-row:1/3;font-size:26px;letter-spacing:-.035em;font-variant-numeric:tabular-nums;line-height:1.4}.ds-price span{display:block;font-size:12px;letter-spacing:0}.ds-price-band ul{grid-column:3;grid-row:1/4;margin:0;padding:0;list-style:none;font-size:14px}.ds-price-band li{padding-bottom:4px}.ds-price-band li+li{margin-top:6px}.ds-price-action{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 23px;font-family:Geologica,sans-serif;font-size:14px;font-weight:400;line-height:1.4;text-align:center;text-decoration:none;border:1px solid transparent;transition:background .18s;grid-column:1/3;justify-self:start;margin-top:7px;background:var(--charcoal,#343330);color:var(--paper,#fdfbf7)}.ds-price-action:hover{background:#22221f}.ds-price-action:focus-visible{outline:2px solid currentColor;outline-offset:5px;}@media(max-width:900px){.ds-price-band{padding:30px 24px;grid-template-columns:1fr 1fr;gap:18px 25px}.ds-price-band ul{grid-column:2;grid-row:2/4}.ds-price{grid-column:2;grid-row:1}.ds-price-action{grid-column:1;grid-row:3;max-width:220px}}@media(max-width:600px){.ds-price-band{grid-template-columns:1fr auto;padding:26px 20px;gap:18px}.ds-price-band h3,.ds-price{font-size:23px}.ds-price-band>p{grid-column:1/-1;grid-row:2;max-width:35ch}.ds-price-band ul{grid-column:1/-1;grid-row:3;font-size:13px}.ds-price-action{grid-column:1/-1;grid-row:4;max-width:none;font-size:13px}}@media(prefers-reduced-motion:reduce){.ds-price-action{transition:none}}\n.ds-price-band h3{font-family:\"Bodoni Moda\",Georgia,serif;font-size:31px;font-weight:400;line-height:1.15;letter-spacing:-.015em}@media(max-width:600px){.ds-price-band h3{font-size:29px}}"
    },
