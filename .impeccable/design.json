      "css": ".ds-btn-outline{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 23px;font-family:Geologica,sans-serif;font-size:14px;font-weight:400;line-height:1.4;text-align:center;text-decoration:none;border:1px solid transparent;transition:background .18s;background:transparent;border-color:var(--charcoal,#343330);color:var(--charcoal,#343330)}.ds-btn-outline:hover{background:var(--charcoal,#343330);color:var(--paper,#fdfbf7)}.ds-btn-outline:focus-visible{outline:2px solid currentColor;outline-offset:5px;}@media(prefers-reduced-motion:reduce){.ds-btn-primary,.ds-btn-light,.ds-btn-outline{transition:none}}"
