    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The main enquiry and continuation action; small header instances reduce to 44px minimum height.",
      "html": "<a class=\"ds-btn-primary\" href=\"#enquiry-preview\">Check your date</a>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 23px;font-family:Geologica,sans-serif;font-size:14px;font-weight:400;line-height:1.4;text-align:center;text-decoration:none;border:1px solid transparent;transition:background .18s;background:var(--charcoal,#343330);color:var(--paper,#fdfbf7)}.ds-btn-primary:hover{background:#22221f}.ds-btn-primary:focus-visible{outline:2px solid currentColor;outline-offset:5px;}@media(prefers-reduced-motion:reduce){.ds-btn-primary,.ds-btn-light,.ds-btn-outline{transition:none}}"
