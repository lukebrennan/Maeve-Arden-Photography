  "narrative": {
    "northStar": "Folded atlas",
    "overview": "An open photographic folio in warm cream and dark charcoal. Bodoni Moda supplies refined editorial headings and the outlined MA and full-name logo; compact Geologica keeps reading, navigation and forms clear. Unequal images, subject-aware crops and practical margins preserve the photography-led composition.",
    "keyCharacteristics": [
      "Cream and ivory surfaces with dark grey actions.",
      "Local Bodoni Moda editorial type and Geologica body/UI.",
      "Unequal, subject-aware photography.",
      "Flat controls and warm dividing rules.",
      "User-directed scenes and reduced-motion support."
    ],
    "rules": [
      {
        "name": "The Tonal Field Rule",
        "body": "Separate major content with cream, ivory and charcoal fields; keep recurring content flat.",
        "section": "colors"
      },
      {
        "name": "The Two Role Rule",
        "body": "Serif for editorial voice, sans serif for reading and operation; restrained headings keep photography leading.",
        "section": "typography"
      },
      {
        "name": "The Flat Content Rule",
        "body": "Reserve the shadow for the floating mobile enquiry action.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use cream and charcoal fields, refined Bodoni Moda headings, compact Geologica UI and visible underlined links.",
      "Do preserve the subject when a photograph is cropped, and retain native ratios in the gallery and contained images in the viewer.",
      "Do make scene changes user-triggered and honor reduced-motion preferences.",
      "Do keep selected, focus, invalid, disabled and loading states distinguishable through more than copy alone.",
      "Do preserve the full-name identity, clear MA favicon and unobtrusive fictional-brand and enquiry-demo disclosures.",
      "Do edit the maintained stylesheet and generator when extending the site; the served CSS and HTML are generated outputs, and the public export excludes development contracts."
    ],
    "donts": [
      "Don't add blue surfaces, oversized headings, another display family or a boxed monogram.",
      "Don't turn the native gallery photographs into equal-height crops or the collection bands into generic floating cards.",
      "Don't remove visible focus, image credits, current navigation states or the enquiry preview's operating limits.",
      "Don't promote hidden legacy eyebrow markup, decorative numbering or text-arrow characters into new component conventions."
    ]
  }
}
